IDD_SETTING DIALOGEX 0, 0, 150, 172
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "TVTDataBroadcastingWV2の設定"
FONT 9, "Meiryo UI", 400, 0, 0x80
BEGIN
    CONTROL         "プラグイン起動時にリモコンを表示しない",IDC_CHECK_DISABLE_REMOTECON,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,6,6,139,10
    CONTROL         "TVTest起動時にプラグインを有効にする",IDC_CHECK_AUTOENABLE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,6,18,139,10
    CONTROL         "前回の字幕状態を起動時に復元する",IDC_CHECK_RESTORE_CAPTION_STATE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,6,30,139,10
    PUSHBUTTON      "郵便番号・保存領域の設定",IDC_BUTTON_NVRAM_SETTING,6,96,96,14
    PUSHBUTTON      "字幕の表示設定",IDC_BUTTON_CAPTION_SETTING,6,114,96,14
    PUSHBUTTON      "キャッシュサーバーの設定",IDC_BUTTON_CACHE_SETTING,6,132,96,14
    CONTROL         "音量をTVTestと連動する",IDC_CHECK_USE_TVTEST_VOLUME,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,6,42,139,10
    CONTROL         "選局ボタンを使っていないときTVTestに渡す",IDC_CHECK_USE_TVTEST_CHANNEL_COMMAND,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,6,54,139,10
    LTEXT           "Comment opacity (0-100):",IDC_STATIC,6,68,100,8
    EDITTEXT        IDC_EDIT_COMMENT_OPACITY,108,65,30,12,ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
    LTEXT           "Comment duration (ms):",IDC_STATIC,6,80,100,8
    EDITTEXT        IDC_EDIT_COMMENT_DURATION,108,77,30,12,ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
    DEFPUSHBUTTON   "OK",IDOK,42,154,50,14
    PUSHBUTTON      "キャンセル",IDCANCEL,96,154,50,14
END

IDD_SETTING_CACHE DIALOGEX 0, 0, 240, 102
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "TVTDataBroadcastingWV2のキャッシュサーバー設定"
FONT 9, "Meiryo UI", 400, 0, 0x80
BEGIN
    LTEXT           "ニコニコ実況への接続をキャッシュサーバー経由にします。空にするとニコニコ実況へ直結します。避難所(RefugeUri)側は影響を受けません。",IDC_STATIC,6,6,228,26
    LTEXT           "この設定はjkcnsl側(jkcnsl.json)に保存され、同じjkcnsl.exeを使うNicoJKとも共有されます。",IDC_STATIC,6,34,228,18
    LTEXT           "キャッシュサーバーURL",IDC_STATIC,6,54,228,8
    EDITTEXT        IDC_EDIT_CACHE_SERVER_URL,6,64,228,12,ES_AUTOHSCROLL
    LTEXT           "",IDC_STATIC_CACHE_STATUS,6,80,120,8
    DEFPUSHBUTTON   "OK",IDOK,130,82,50,14
    PUSHBUTTON      "キャンセル",IDCANCEL,184,82,50,14
END

